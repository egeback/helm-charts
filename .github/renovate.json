{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "gitAuthor": "egeback <3228822+egeback@users.noreply.github.com>",
  "dependencyDashboard": true,
  "rebaseWhen": "behind-base-branch",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Chart\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+?) depName=(?<depName>[^\\s]+?)(?:\\s+versioning=(?<versioning>[^\\s]+?))?\\s+appVersion:\\s*[\"']?(?<currentValue>[^\\s\"']+)[\"']?"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)values\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+?) depName=(?<depName>[^\\s]+?)(?:\\s+versioning=(?<versioning>[^\\s]+?))?\\s+tag:\\s*[\"']?(?<currentValue>[^\\s\"']+)[\"']?"
      ]
    },
    {
      "customType": "regex",
      "description": "Helm version used in the chart CI",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+?) depName=(?<depName>[^\\s]+?)\\s+HELM_VERSION:\\s*[\"']?(?<currentValue>[^\\s\"']+)[\"']?"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "postgresql"
      ],
      "matchFileNames": [
        "charts/teslamate/Chart.yaml"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "bjw-s/common"
      ],
      "groupName": "bjw-s common chart"
    },
    {
      "matchPackageNames": [
        "home-assistant/core",
        "AdguardTeam/AdGuardHome"
      ],
      "versioning": "docker",
      "separateMajorMinor": false
    },
    {
      "description": "Bundled recorder DB: stay on the MariaDB 12.3 LTS series (HA supports LTS only)",
      "matchFileNames": [
        "charts/home-assistant/values.yaml"
      ],
      "matchPackageNames": [
        "mariadb"
      ],
      "allowedVersions": "/^12\\.3\\./"
    },
    {
      "description": "Bundled PostgreSQL: major upgrades need a dump/restore, stay on 18.x",
      "matchFileNames": [
        "charts/home-assistant/values.yaml",
        "charts/teslamate/values.yaml"
      ],
      "matchPackageNames": [
        "postgres"
      ],
      "allowedVersions": "/^18\\./"
    }
  ]
}
